        "WY",
        "DC",
        "AS",
        "GU",
        "MP",
        "PR",
        "VI"
      ]
    },
    "censusRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "first_name",
        "last_name",
        "work_state",
        "compensation_type",
        "employment_type",
        "classification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "[^ ]"
        },
        "first_name": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "[^ ]"
        },
        "last_name": {
          "type": "string",
          "maxLength": 200
        },
        "dob": {
          "type": "string",
          "maxLength": 40
        },
        "age": {
          "type": "integer",
          "minimum": 14,
          "maximum": 100
        },
        "work_state": {
          "title": "blank or a US state or territory code such as CA",
          "type": "string",
          "enum": [
            "",
            "AL",
            "AK",
            "AZ",
            "AR",
            "CA",
            "CO",
            "CT",
            "DE",
            "FL",
            "GA",
            "HI",
            "ID",
            "IL",
            "IN",
            "IA",
            "KS",
            "KY",
            "LA",
            "ME",
            "MD",
            "MA",
            "MI",
            "MN",
            "MS",
            "MO",
            "MT",
            "NE",
            "NV",
            "NH",
            "NJ",
            "NM",
            "NY",
            "NC",
            "ND",
            "OH",
            "OK",
            "OR",
            "PA",
            "RI",
            "SC",
            "SD",
            "TN",
            "TX",
            "UT",
            "VT",
            "VA",
            "WA",
            "WV",
            "WI",
            "WY",
            "DC",
            "AS",
            "GU",
            "MP",
            "PR",
            "VI"
          ]
        },
        "zip_code": {
          "type": "string",
          "pattern": "^[0-9]{5}(-[0-9]{4})?$"
        },
        "job_title": {
          "type": "string",
          "maxLength": 200
        },
        "annual_salary": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "compensation_type": {
          "type": "string",
          "enum": [
            "salary",
            "hourly"
          ]
        },
        "employment_type": {
          "type": "string",
          "enum": [
            "full_time",
            "part_time"
          ]
        },
        "classification": {
          "type": "string",
          "enum": [
            "w2",
            "1099"
          ]
        },
        "coverage_tier": {
          "type": "string",
          "enum": [
            "EE",
            "EE+SP",
            "EE+CH",
            "FAM",
            "WAIVE"
          ]
        },
        "class_code": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "dependents": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/dependent"
          }
        }
      }
    },
    "dependent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_name"
      ],
      "properties": {
        "first_name": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "[^ ]"
        },
        "last_name": {
          "type": "string",
          "maxLength": 200
        },
        "dob": {
          "type": "string",
          "maxLength": 40
        },
        "relationship": {
          "type": "string",
          "enum": [
            "spouse",
            "domestic_partner",
            "child",
            "other"
          ]
        }
      }
    }
  }
}
