        },
        "dependents": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/dependent"
          }
        },
        "assumed": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "classification",
              "employment_type",
              "annual_salary"
            ]
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "legal_name": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "[^ ]"
        },
        "fein": {
          "title": "nine digits, such as 123456789",
          "type": "string",
          "pattern": "^[0-9]{9}$"
        }
      }
