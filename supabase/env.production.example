# Function secrets for a Supabase project. Copy to supabase/.env.production (git-ignored) and fill
# in, then run scripts/supabase-setup.mjs (docs/SUPABASE_SETUP.md). Blank lines are skipped, so
# optional settings can stay empty. Don't add SUPABASE_* names: Supabase sets those itself.

# --- AI (required) ---------------------------------------------------------------------------
# Anthropic is the only AI provider (decision D11), for Lenore and for reading documents. AI_PROVIDER
# may stay empty or say anthropic; any other value is refused.
ANTHROPIC_API_KEY=
AI_PROVIDER=
# Optional: the model (default claude-haiku-5-5).
AI_MODEL=

# --- The site (required) ---------------------------------------------------------------------
# The production site's address, no path. Used for links in emails and the sign-in redirect.
APP_BASE_URL=https://nevermorepeo.com

# --- Email (required to accept submissions) --------------------------------------------------
# Resend sends the notifications, and the setup also routes Supabase's sign-in emails (the 6-digit
# code a prospect needs to certify) through Resend's SMTP. EMAIL_FROM must be on a domain verified
# in Resend (SPF and DKIM). See docs/NOTIFICATIONS.md.
# EMAIL_FROM looks like: "Nevermore <intake@mail.yourdomain.com>" (keep the quotes).
# RESEND_API_KEY is the key alone (re_...), nothing after it: the setup tries it on Resend first and
# stops if Resend refuses it, and it becomes Supabase Auth's SMTP password too.
RESEND_API_KEY=
EMAIL_FROM=
# Who gets the new-submission alert (comma-separated for several).
ADVISORY_NOTIFY_EMAIL=
# Shown to the prospect in their confirmation email. PROSPECT_RESPONSE_TIME is a promise, e.g.
# "two business days": pick one you can keep.
SUPPORT_EMAIL=
PROSPECT_RESPONSE_TIME=
# The signing secret (whsec_...) of the Resend webhook that points at the resend-webhook function:
# https://<project-ref>.supabase.co/functions/v1/resend-webhook, subscribed to email.bounced,
# email.complained, email.delivery_delayed, email.failed and email.suppressed. Without it, bounces
# and complaints are not processed and bounced addresses are mailed again. See docs/NOTIFICATIONS.md.
RESEND_WEBHOOK_SECRET=

# Receiving PEO mail (docs/adr/0004-peo-mail-is-received-before-the-product-sends.md). All four are needed, and
# until they are set the receive-mail function answers 503 and the provider retries:
#   RESEND_INBOUND_WEBHOOK_SECRET  the signing secret (whsec_...) of the Resend webhook pointed at
#                                  https://<project-ref>.supabase.co/functions/v1/receive-mail and subscribed to
#                                  email.received. It is a different webhook from the one above, with its own secret.
#   QUOTE_REPLY_DOMAIN             the subdomain Resend receives mail for, e.g. quotes.nevermorepeo.com: the same
#                                  value as VITE_QUOTE_REPLY_DOMAIN in the front end's environment.
#   PEO_MAIL_RECEIVING             "on" turns receiving on; anything else, or unset, switches it off at once with
#                                  nothing lost: the provider keeps the mail and retries. Counsel has not yet
#                                  reviewed the product storing PEO mail (docs/LEGAL_REVIEW.md).
#   RESEND_API_KEY                 as above: the function fetches each message and its attachments with it.
# Attachments are scanned like uploads, so MALWARE_SCANNER (below) has to be set too.
RESEND_INBOUND_WEBHOOK_SECRET=
QUOTE_REPLY_DOMAIN=
PEO_MAIL_RECEIVING=

# The malware scanner every upload is checked with before anyone can open it (docs/RUNBOOK.md,
# "Malware detected"; decision D13; docs/adr/0002-uploads-need-a-scanner-in-production.md). Without
# one, uploads are refused and the prospect is told uploads are paused. Production uses scanii.
#   scanii  Scanii's hosted API (production): SCANII_API_KEY and SCANII_API_SECRET, an API key made in
#           Scanii's US region. SCANII_API_URL only for another region (https://api-eu1.scanii.com, say).
#   clamav  a clamd daemon behind TLS (stunnel or similar): CLAMAV_HOST, and CLAMAV_PORT (3310 if unset).
#   http    an HTTPS scanning service: MALWARE_SCANNER_URL and MALWARE_SCANNER_TOKEN. It is sent the file
#           (POST, application/octet-stream, Bearer token) and answers {"verdict":"clean"} or
#           {"verdict":"infected","signature":"..."}.
#   none    no scanning: every file is readable unscanned. Only with APP_ENV below set to development,
#           demo or staging; on production it counts as unset.
MALWARE_SCANNER=
SCANII_API_KEY=
SCANII_API_SECRET=
SCANII_API_URL=
CLAMAV_HOST=
CLAMAV_PORT=
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=
# Which environment this project is: leave it empty on production (empty means production). development,
# demo or staging allow MALWARE_SCANNER=none; use them only on a project that holds no prospects' files.
APP_ENV=

# --- Optional --------------------------------------------------------------------------------
# A Slack or Teams incoming webhook (https) for engineering alerts: dead notification emails
# (dispatch-outbox), failed deletions (purge-intakes), malware detections and scans that gave up
# (document-upload, document-scan) and failure spikes (ops-monitor). Without it
# alerts are only log lines. Set it before launch. See docs/RUNBOOK.md.
ENGINEERING_ALERT_WEBHOOK_URL=
# Generated by the setup when absent; set it only to keep a value you already use.
IP_HASH_SECRET=
# AI call ceilings (defaults 20 per address per minute, 400 per address per day, 2000 a day overall).
AI_IP_PER_MINUTE=
AI_IP_PER_DAY=
AI_GLOBAL_DAILY_CALLS=
