# Copy to .env and fill in. Only publishable (browser-safe) values belong here.
# Never put a service-role key, AI key, or any other secret in a VITE_* variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Voice is a beta behind a flag; leave empty to keep it off.
VITE_ELEVENLABS_AGENT_ID=
# Cloudflare Turnstile site key (publishable). Leave empty to skip the guest CAPTCHA, e.g. locally.
# The matching secret goes in Supabase Auth -> Attack Protection, never in a VITE_* variable.
VITE_TURNSTILE_SITE_KEY=
