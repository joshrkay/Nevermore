# Copy to .env and fill in. Only publishable (browser-safe) values belong here.
# Never put a service-role key, AI key, or any other secret in a VITE_* variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Voice is a beta behind a flag; leave empty to keep it off.
VITE_ELEVENLABS_AGENT_ID=
# Cloudflare Turnstile site key (publishable). Leave empty to skip the guest CAPTCHA, e.g. locally.
# It is also the key of the "contact me" form on a firm's public link (slice 8.7b): with it empty that form is not offered
# ("Asking to be contacted isn't available right now"), and with it set the function contact-request needs TURNSTILE_SECRET_KEY
# (a function secret in supabase/.env.production, docs/SUPABASE_SETUP.md), never a VITE_* variable.
# For Supabase Auth's own CAPTCHA the matching secret goes in Authentication -> Attack Protection (see docs/SUPABASE_SETUP.md first).
VITE_TURNSTILE_SITE_KEY=
# The subdomain that receives PEO mail for quote requests, e.g. quotes.example.com. Leave empty to keep reply
# addresses off: set it only once that subdomain's mail reaches the product (docs/adr/0004).
VITE_QUOTE_REPLY_DOMAIN=
